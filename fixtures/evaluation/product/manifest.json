{
  "dataset_id": "product-demand-v1",
  "policy_id": "product-demand",
  "policy_version": 1,
  "min_samples": 10,
  "threshold_thousandths": 800,
  "budget_micros": 1000,
  "external_method": {
    "id": "method-demand-interview",
