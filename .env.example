# Copy to a private .env. Never commit real credentials.
# Node/npm scripts do not all load this file automatically.
# Start with: node --env-file=.env --import=tsx src/index.ts

PATRICK_MODE=live
PATRICK_HOST=127.0.0.1
PATRICK_PORT=4317
PATRICK_CONFIG=examples/patrick.config.json
PATRICK_OWNER_ID=owner
PATRICK_SCAN_INTERVAL_MS=60000

# Generate a private value with Node's crypto.randomBytes(32).
# Leave this commented if using the bootstrap-generated access token.
# PATRICK_TOKEN=replace-with-a-private-random-token
# Optional independent signing secret; omit rather than set an empty value.
# PATRICK_SESSION_SECRET=replace-with-another-private-random-secret

# Defaults on macOS to ~/Library/Application Support/PAtrick.
# Active DB/WAL/credentials must stay outside the sync directory.
# Use absolute paths. Node --env-file does not expand $HOME or ~ here.
# PATRICK_DATA_DIR=/absolute/private/path/PAtrick
# PATRICK_VAULT_DIR=/absolute/approved/path/PAtrickVault

# Optional non-secret host Lima instance store; omit for ordinary Lima defaults.
# Use the same dedicated, reviewed home used when creating the VM.
# The chosen limactl binary must also be on the host service PATH.
# Only PATH/HOME/TMPDIR and optional LIMA_HOME reach the host Lima transport.
# LIMA_HOME=/absolute/private/path/lima

# Writer only. Prefer a short-lived authorized GitHub App installation token.
# Existing GITHUB_TOKEN or GH_TOKEN are also read if PATRICK_GITHUB_TOKEN is absent.
# PATRICK_GITHUB_TOKEN=
# Optional later GitLab integration, accepted separately.
# PATRICK_GITLAB_URL=https://gitlab.example.org
# PATRICK_GITLAB_TOKEN=

# Feishu WS/send/history need app credentials, verified owner and private chat ID.
# Authorized history must succeed before channel readiness; manual private setup is supported.
# PATRICK_OWNER_ID and FEISHU_OWNER_OPEN_ID should identify the same owner.
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_OWNER_OPEN_ID=
# FEISHU_CHAT_ID=
# Optional for WS/send/history; HTTP callbacks require a real nonblank token.
# Missing/empty/whitespace-only token keeps /webhooks/feishu closed (403).
# FEISHU_VERIFICATION_TOKEN=
# Set when HTTP callback encryption is enabled.
# FEISHU_ENCRYPT_KEY=

# Gateway: POST {query,language,projectId,domain}; see docs/operations.md.
# HTTPS or a local-loopback HTTP endpoint. Originals must use public HTTPS.
# PATRICK_RESEARCH_URL=https://your-approved-gateway.example/search
# PATRICK_RESEARCH_TOKEN=

# Optional MCP stdio client. Start the HTTP host first and provide its access token.
# MCP does not create a second database writer or read access-token automatically.
# PATRICK_URL=http://127.0.0.1:4317
# PATRICK_MCP_PROJECT=patrick
# PATRICK_MCP_DOMAIN=personal

# Online snapshot destination; omit to use dataDir/backups/<timestamp>.
# PATRICK_BACKUP_DIR=/absolute/approved/path/PAtrickBackups/snapshot-name
# If set, backup.ts also invokes restic after verifying the local snapshot.
# Supply the repository and password file privately; initialize/authorize them first.
# RESTIC_REPOSITORY=sftp:approved-backup-host:/approved/path/patrick
# RESTIC_PASSWORD_FILE=/absolute/private/path/restic-password
